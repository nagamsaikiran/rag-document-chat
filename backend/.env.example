# Copy to .env and fill in. Never commit your real .env.

# Which providers to use. Swap these to change backends without touching code.
# Options: openai | gemini
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini (FREE tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (only needed if LLM_PROVIDER/EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Multimodal ingestion: use a vision model to read tables, charts, figures, and
# scanned text (one vision call per page; slower, uses more quota). Set to false
# for fast text-only extraction.
MULTIMODAL=false
MULTIMODAL_DPI=150

# Retrieval / chunking knobs (tradeoffs documented in README)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Hybrid retrieval: fuse vector similarity with BM25 keyword matching (RRF).
HYBRID_SEARCH=true
# Cosine distance above which a chunk is considered irrelevant (drives the
# "I don't know" guardrail). 0 = identical, 2 = opposite. Leave unset to use
# the per-provider default (openai: 0.55, gemini: 0.60); tune with the eval set.
#RELEVANCE_DISTANCE_THRESHOLD=0.55

# Conversation memory: previous turns used for follow-up question rewriting.
MAX_HISTORY_TURNS=6

# Security / resource limits (defaults shown)
CORS_ORIGINS=*
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=5
MAX_PAGES=50
MAX_PAGES_VISION=30
MAX_QUESTION_CHARS=2000
MAX_SESSION_CHUNKS=5000
RATE_LIMIT_PER_MIN=20
# Auto-delete a visitor's documents N days after upload (0 = keep forever).
SESSION_TTL_DAYS=7
# Show real error details in API responses. true = local dev (actionable
# messages); the Docker image sets false so deploys never leak internals.
DEBUG_ERRORS=true

# Where Chroma persists its index
CHROMA_DIR=./.chroma
